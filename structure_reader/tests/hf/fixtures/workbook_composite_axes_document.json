          "parameter_refs": ["p_batch", "p_gate"],
          "kind": "activation",
          "note": "直接轴 E：靠显式引用在两个同名候选中选到 p_gate。"
        },
        {
          "id": "t_expert_out",
          "name": "expert_out",
          "shape": ["E×Nh"],
          "parameter_refs": ["p_experts", "p_nh"],
          "kind": "activation",
          "note": "复合轴 E×Nh：同名候选 E 靠显式引用选到 p_experts（不是 p_gate）。"
