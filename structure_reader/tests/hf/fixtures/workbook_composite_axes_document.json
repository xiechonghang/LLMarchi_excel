        {
          "id": "t_partial_unknown",
          "name": "unknown_part_view",
          "shape": ["Nh×Dx"],
          "parameter_refs": ["p_nh"],
          "kind": "activation",
          "note": "Dx 未声明：Nh 照旧联查，Dx 列入未命中。"
