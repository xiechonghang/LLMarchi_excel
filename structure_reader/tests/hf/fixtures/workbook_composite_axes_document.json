        {
          "id": "p_window",
          "symbol": "W",
          "meaning": "滑窗长度",
          "value": 4096,
          "expression": null,
          "note": "W-1 里的 1 是常数，不是缺失参数。",
          "source_refs": [{"path": "cfg.json", "locator": "sliding_window", "kind": "config", "note": "合成"}]
        },
        {
          "id": "p_ki",
          "symbol": "Ki",
          "meaning": "候选专家数",
          "value": 8,
          "expression": null,
          "note": "min/max 的参数应各自联查。",
          "source_refs": [{"path": "cfg.json", "locator": "topk_candidate", "kind": "config", "note": "合成"}]
